import base64, gzip
from urllib.parse import quote

email  = """{{ $.request.requestedByUserPrincipalName }}"""
fname  = """{{ $.request.applicationDetail.fileName }}"""
fhash  = """{{ $.request.applicationDetail.fileHash }}"""
tenant = """{{ $.pick_skyline_tenant_id.output }}"""

def clean(v):
    v = (v or "").strip()
    return "" if v.lower() in ("<nil>", "null", "none", "<no value>") else v

email, fname, tenant = clean(email), clean(fname), clean(tenant)
fhash = clean(fhash).upper()
if len(fhash) != 64 or any(c not in "0123456789ABCDEF" for c in fhash):
    fhash = ""
user = email.split("@")[0]
esc = lambda s: s.replace("\\", "\\\\").replace('"', '\\"')
FENCE = "`" * 3

def link(q):
    packed = base64.b64encode(gzip.compress(q.encode())).decode()
    return ("https://security.microsoft.com/v2/advanced-hunting?tid="
            + quote(tenant, safe="") + "&query=" + quote(packed, safe=""))

hunts = []
if fhash:
    hunts.append(("Download source & creation date", f'''DeviceFileEvents
| where Timestamp > ago(30d)
| where SHA256 =~ "{fhash}"
| project Timestamp, DeviceName, ActionType, FolderPath, FileOriginUrl, FileOriginReferrerUrl, InitiatingProcessFileName, InitiatingProcessAccountName
| order by Timestamp asc'''))
    hunts.append(("Devices with this hash", f'''union DeviceFileEvents, DeviceProcessEvents
| where Timestamp > ago(30d)
| where SHA256 =~ "{fhash}"
| summarize Devices = dcount(DeviceId), DeviceList = make_set(DeviceName, 100), FirstSeen = min(Timestamp)'''))
elif fname and user:
    hunts.append(("Download source & creation date (by file name + user)", f'''DeviceFileEvents
| where Timestamp > ago(30d)
| where FileName =~ "{esc(fname)}" and InitiatingProcessAccountName =~ "{esc(user)}"
| project Timestamp, DeviceName, ActionType, FolderPath, FileOriginUrl, FileOriginReferrerUrl, SHA256
| order by Timestamp asc'''))
if user:
    hunts.append(("Devices the user signed in to", f'''DeviceLogonEvents
| where Timestamp > ago(30d)
| where AccountName =~ "{esc(user)}"
| summarize LastLogon = max(Timestamp), Logons = count() by DeviceName
| top 10 by LastLogon desc'''))

out = ["### Defender Hunting", "Searches cover the last 30 days."]
for title, q in hunts:
    out.append("#### " + title)
    out.append(f"[Open in Defender]({link(q)})" if tenant
               else "_No tenant ID. Paste the query into Advanced Hunting._")
    out.append(f"{FENCE}\n{q}\n{FENCE}")
if not hunts:
    out.append("No usable file hash, file name or user on the request.")
print("\n\n".join(out))
